{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'locksmith'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=locksmith",
                    "--package=win-locksmith"
                ],
                "filter": {
                    "name": "locksmith",
                    "kind": "bin"
                }
            },
            "args": ["${input:targetPath}"],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'locksmith'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=locksmith",
                    "--package=win-locksmith"
                ],
                "filter": {
                    "name": "locksmith",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "targetPath",
            "type": "promptString",
            "description": "File or directory to scan"
        }
    ]
}
